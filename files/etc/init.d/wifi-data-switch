#!/bin/sh /etc/rc.common
START=96
STOP=12
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/libexec/wifi-data-switch/controller.py daemon
    procd_set_param respawn 60 10 5
    # Native mode restores DNS and the previous OpenClash service on shutdown.
    procd_set_param term_timeout 90
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
